# ---------------------------------------------------------------------------
# QuoteCue AI environment variables
# Copy to .env for local development. Never commit .env.
# ---------------------------------------------------------------------------

# Application
APP_URL=http://localhost:3000            # Public URL (https://... in production)
NODE_ENV=development                     # development | test | production
PORT=3000                                # Railway injects PORT automatically

# Database (Railway PostgreSQL: reference ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quotecue
DIRECT_URL=                              # Optional direct (non-pooled) URL; defaults to DATABASE_URL

# Authentication (Better Auth)
BETTER_AUTH_SECRET=                      # 32+ random characters: openssl rand -base64 48
BETTER_AUTH_URL=                         # Optional; defaults to APP_URL
SUPER_ADMIN_EMAIL=                       # Promoted on seed if the account exists; see pnpm admin:promote

# Storage (Railway Storage Bucket, S3-compatible). Map bucket variables as:
#   BUCKET            -> STORAGE_BUCKET
#   ENDPOINT          -> STORAGE_ENDPOINT
#   REGION            -> STORAGE_REGION
#   ACCESS_KEY_ID     -> STORAGE_ACCESS_KEY_ID
#   SECRET_ACCESS_KEY -> STORAGE_SECRET_ACCESS_KEY
STORAGE_PROVIDER=local                   # railway | s3 | local (dev only) | memory (tests only)
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=true
LOCAL_STORAGE_PATH=.local-storage        # Development only; git-ignored

# Stripe (test mode keys for development). Leave blank locally for mock billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_CREDIT_PACK_PRICE_ID=

# OpenAI. Leave OPENAI_API_KEY blank locally to use the mock AI provider.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Email (Resend). Leave RESEND_API_KEY blank locally for email preview mode.
RESEND_API_KEY=
EMAIL_FROM=QuoteCue AI <noreply@example.com>
SUPPORT_EMAIL=support@example.com

# Demo and analytics
DEMO_MODE=true                           # Seeds and exposes the Northstar Electrical demo workspace
ANALYTICS_ID=                            # Optional external analytics ID (never required)
